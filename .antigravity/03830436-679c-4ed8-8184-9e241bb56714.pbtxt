          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "<pre className=\"text-sm font-mono leading-tight\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "<span className=\"text-gray-500\">// Setup run once</span>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "<span className=\"text-gray-500\">// Setup runs once when you power on the Arduino</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<span className=\"text-[#FF6B6B]\">void</span> setup() {\'{\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  <span className=\"text-gray-500\">// Tell Pin 13 to act as an OUTPUT (sending electricity out)</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  pinMode(13, OUTPUT);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "{\'}\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "<span className=\"text-gray-500\">// Loop forever</span>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "<span className=\"text-gray-500\">// Loop runs over and over forever</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<span className=\"text-[#FF6B6B]\">void</span> loop() {\'{\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  <span className=\"text-gray-500\">// Turn LED ON (HIGH = full voltage)</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  digitalWrite(13, HIGH);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  delay(1000);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "  <span className=\"text-gray-500\">// Wait for 1000 milliseconds (1 full second)</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  delay(1000);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  <span className=\"text-gray-500\">// Turn LED OFF (LOW = 0 voltage)</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  digitalWrite(13, LOW);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  <span className=\"text-gray-500\">// Wait another second before repeating</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  delay(1000);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "{\'}\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
