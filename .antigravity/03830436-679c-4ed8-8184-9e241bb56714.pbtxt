          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <li>Place the LED on the breadboard. Note: The longer leg is Positive (Anode), the shorter is Negative (Cathode).</li>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <li>Connect the <strong>220\316\251 Resistor</strong> from the negative (-) rail to the shorter leg of the LED.</li>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <li>Connect a jumper wire from Arduino <strong>Pin 13</strong> to the longer leg of the LED.</li>"
