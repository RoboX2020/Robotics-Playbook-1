      replacement_content: "        <h2 className=\"text-2xl font-black mb-6 uppercase flex items-center gap-2\">\n          <span className=\"text-2xl\">\360\237\224\214</span> The Wiring Diagram\n        </h2>\n        <div className=\"doodle-card p-6 bg-white shadow-[8px_8px_0px_0px_rgba(255,215,0,1)]\">"
    }
    replacement_chunks {
      target_content: "        <h2 className=\"text-3xl font-bold mb-6 flex items-center gap-3\">\n          <Code className=\"w-8 h-8 text-indigo-500\" /> The Code\n        </h2>\n        <div className=\"doodle-card p-0 bg-gray-900 text-white overflow-hidden\">\n          <div className=\"bg-gray-800 p-4 border-b-4 border-black flex gap-2\">\n             <div className=\"w-4 h-4 rounded-full bg-red-500 border-2 border-black\"></div>\n             <div className=\"w-4 h-4 rounded-full bg-yellow-500 border-2 border-black\"></div>\n             <div className=\"w-4 h-4 rounded-full bg-green-500 border-2 border-black\"></div>\n             <span className=\"ml-4 font-mono font-bold text-sm text-gray-400\">blink.ino</span>\n          </div>\n          <div className=\"p-6 overflow-x-auto\">\n<pre className=\"font-mono text-lg leading-relaxed\">\n<code className=\"text-blue-300\">void</code> <code className=\"text-yellow-200\">setup</code>() {\'{\'}\n  <span className=\"text-gray-500\">// Initialize digital pin 13 as an output.</span>\n  <code className=\"text-cyan-300\">pinMode</code>(13, OUTPUT);\n{\'}\'}\n\n<code className=\"text-blue-300\">void</code> <code className=\"text-yellow-200\">loop</code>() {\'{\'}\n  <code className=\"text-cyan-300\">digitalWrite</code>(13, HIGH);  <span className=\"text-gray-500\">// Turn LED on (HIGH voltage)</span>\n  <code className=\"text-cyan-300\">delay</code>(1000);              <span className=\"text-gray-500\">// Wait for 1000 milliseconds (1 sec)</span>\n  \n  <code className=\"text-cyan-300\">digitalWrite</code>(13, LOW);   <span className=\"text-gray-500\">// Turn LED off (LOW voltage)</span>\n  <code className=\"text-cyan-300\">delay</code>(1000);              <span className=\"text-gray-500\">// Wait for a second</span>\n{\'}\'}\n</pre>\n          </div>\n        </div>"
      replacement_content: "        <h2 className=\"text-2xl font-black mb-6 uppercase flex items-center gap-2\">\n          <Code className=\"w-6 h-6 text-[#6BCB77]\" /> The Code\n        </h2>\n        <div className=\"doodle-card p-0 bg-[#1A1A1A] text-white overflow-hidden shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]\">\n          <div className=\"bg-black p-4 border-b-4 border-black flex items-center justify-between\">\n             <div className=\"flex gap-2\">\n               <div className=\"w-4 h-4 rounded-full bg-[#FF6B6B] border-2 border-black\"></div>\n               <div className=\"w-4 h-4 rounded-full bg-[#FFD700] border-2 border-black\"></div>\n               <div className=\"w-4 h-4 rounded-full bg-[#6BCB77] border-2 border-black\"></div>\n             </div>\n             <span className=\"text-[10px] px-2 py-1 bg-white/10 rounded border border-white/20 font-bold uppercase tracking-widest\">blink.ino</span>\n          </div>\n          <div className=\"p-6 overflow-x-auto\">\n<pre className=\"text-sm font-mono leading-tight\">\n<span className=\"text-gray-500\">// Setup run once</span>\n<span className=\"text-[#FF6B6B]\">void</span> setup() {\'{\'}\n  pinMode(13, OUTPUT);\n{\'}\'}\n\n<span className=\"text-gray-500\">// Loop forever</span>\n<span className=\"text-[#FF6B6B]\">void</span> loop() {\'{\'}\n  digitalWrite(13, HIGH);\n  delay(1000);\n  digitalWrite(13, LOW);\n  delay(1000);\n{\'}\'}\n</pre>\n          </div>\n        </div>"
    }
    replacement_chunks {
      target_content: "        <h2 className=\"text-3xl font-bold mb-6 flex items-center gap-3\">\n          <CheckSquare className=\"w-8 h-8 text-orange-500\" /> Your Turn! (Exercises)\n        </h2>\n        <div className=\"space-y-6\">\n          <div className=\"doodle-card p-6 bg-orange-50\">\n            <h3 className=\"text-xl font-bold mb-2 flex items-center gap-2\">\n              <span className=\"text-2xl\">\360\237\220\207</span> Exercise 1: Speed it up!\n            </h3>\n            <p className=\"font-medium text-lg\">\n              Modify the code so the LED blinks twice as fast. \n              (Hint: change the numbers inside the <code>delay()</code> function).\n            </p>\n          </div>\n\n          <div className=\"doodle-card p-6 bg-pink-50\">\n            <h3 className=\"text-xl font-bold mb-2 flex items-center gap-2\">\n              <span className=\"text-2xl\">\360\237\206\230</span> Exercise 2: S.O.S.\n            </h3>\n            <p className=\"font-medium text-lg\">\n              Morse code time! Write a program that blinks S.O.S. \n              (3 short blinks, 3 long blinks, 3 short blinks). Use a 200ms delay for short, and 600ms for long.\n            </p>\n          </div>\n\n          <div className=\"doodle-card p-6 bg-purple-50\">\n            <h3 className=\"text-xl font-bold mb-2 flex items-center gap-2\">\n              <span className=\"text-2xl\">\360\237\232\246</span> Exercise 3: Police Lights (Challenge)\n            </h3>\n            <p className=\"font-medium text-lg\">\n              Add a second LED (maybe blue?) to pin 12. Wire it up with its own resistor. \n              Then, change your code so Pin 13 blinks, turns off, and then Pin 12 blinks!\n            </p>\n          </div>\n        </div>"
      replacement_content: "        <h2 className=\"text-2xl font-black mb-6 uppercase flex items-center gap-2\">\n          <CheckSquare className=\"w-6 h-6 text-black\" /> Your Turn! (Exercises)\n        </h2>\n        <div className=\"space-y-6\">\n          <div className=\"doodle-card p-6 bg-[#6BCB77] shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]\">\n            <h3 className=\"text-xl font-black mb-2 flex items-center gap-2 uppercase\">\n              <span className=\"text-2xl\">\360\237\220\207</span> Exercise 1: Speed it up!\n            </h3>\n            <p className=\"font-bold text-sm\">\n              Modify the code so the LED blinks twice as fast. \n              (Hint: change the numbers inside the <code>delay()</code> function).\n            </p>\n          </div>\n\n          <div className=\"doodle-card p-6 bg-[#FF6B6B] shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]\">\n            <h3 className=\"text-xl font-black mb-2 flex items-center gap-2 uppercase\">\n              <span className=\"text-2xl\">\360\237\206\230</span> Exercise 2: S.O.S.\n            </h3>\n            <p className=\"font-bold text-sm\">\n              Morse code time! Write a program that blinks S.O.S. \n              (3 short blinks, 3 long blinks, 3 short blinks). Use a 200ms delay for short, and 600ms for long.\n            </p>\n          </div>\n\n          <div className=\"doodle-card p-6 bg-[#4D96FF] shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]\">\n            <h3 className=\"text-xl font-black mb-2 flex items-center gap-2 uppercase\">\n              <span className=\"text-2xl\">\360\237\232\246</span> Exercise 3: Police Lights\n            </h3>\n            <p className=\"font-bold text-sm\">\n              Add a second LED (maybe blue?) to pin 12. Wire it up with its own resistor. \n              Then, change your code so Pin 13 blinks, turns off, and then Pin 12 blinks!\n            </p>\n          </div>\n        </div>"
