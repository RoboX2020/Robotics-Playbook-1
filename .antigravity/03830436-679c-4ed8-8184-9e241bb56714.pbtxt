          text: "      {/* Math & Physics Formulas */}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <section className=\"mb-12\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <h2 className=\"text-2xl font-black mb-6 uppercase flex items-center gap-2\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <span className=\"text-2xl\">\360\237\247\256</span> Math & Physics"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </h2>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"doodle-card p-6 md:p-8 bg-[#FAFAFA] shadow-[8px_8px_0px_0px_rgba(107,203,119,1)] relative overflow-hidden\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <div className=\"absolute -right-8 -top-8 opacity-10\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <span className=\"text-9xl\">V=IR</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <h3 className=\"text-2xl font-bold mb-4\">Ohm\'s Law</h3>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <p className=\"text-lg font-medium mb-6\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            Ohm\'s Law is the most important formula in electronics. It connects Voltage, Current, and Resistance."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <div className=\"flex flex-col md:flex-row gap-6 mb-6\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <div className=\"bg-white border-4 border-black p-4 rounded-xl flex-1 text-center shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <span className=\"text-3xl font-black font-mono\">V = I \303\227 R</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <p className=\"mt-2 text-sm font-bold text-gray-600\">Voltage = Current \303\227 Resistance</p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <div className=\"bg-white p-6 border-4 border-black rounded-xl border-dashed\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <h4 className=\"font-bold text-xl mb-2\">Why a 220\316\251 Resistor?</h4>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <p className=\"mb-4\">Our Arduino supplies <strong>5V</strong>. A typical red LED needs about <strong>2V</strong> and likes a current of <strong>0.02A</strong> (20mA).</p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <div className=\"font-mono bg-gray-100 p-4 rounded-lg border-2 border-black\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              R = (Supply Voltage - LED Voltage) / Current<br/>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              R = (5V - 2V) / 0.02A<br/>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              R = 3V / 0.02A<br/>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              R = 150 Ohms"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <p className=\"mt-4 font-bold text-green-700\">We use 220\316\251 because it\'s a common standard size and provides a safe buffer!</p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      </section>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
