        lines {
          text: "              <div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <strong className=\"text-xl block\">Resistance (R)</strong>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <span>Obstacles that slow down the current. Keeps things from blowing up! Measured in Ohms (\316\251).</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
